# Alkalmazás alapbeállítások
APP_NAME="Enterprise Knowledge Assistant"
LOG_LEVEL="INFO"

# Szolgáltató választás: "gemini" (felhős) vagy "ollama" (ingyenes lokális)
LLM_PROVIDER="gemini"
EMBEDDING_PROVIDER="gemini"

# Felhős (Google Gemini) beállítások
GEMINI_API_KEY="ide-ird-a-sajat-gemini-api-kulcsodat"
GEMINI_LLM_MODEL="gemini-3.8-flash"
GEMINI_EMBEDDING_MODEL="models/text-embedding-004"

# Lokális (Ollama) beállítások - ingyenes, API-kulcs nélküli alternatíva
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_LLM_MODEL="llama3.2"
OLLAMA_EMBEDDING_MODEL="nomic-embed-text"

# RAG és Vektoros tároló beállítások
DATA_DIR="data"
CHROMA_PERSIST_DIR="chroma_db"
CHROMA_COLLECTION_NAME="company_knowledge_base"
CHUNK_SIZE=500
CHUNK_OVERLAP=100
RETRIEVAL_TOP_K=3
LLM_TIMEOUT_SECONDS=30.0
